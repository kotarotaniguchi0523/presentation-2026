#!/bin/sh
# ステージした workflow を jactionlint で見る。
#
#   git config core.hooksPath .githooks
#   mise use -g github:jdx/jactionlint@2.3.0   # これで jactionlint が PATH に入る
#
# jactionlint が無い環境では、環境で止めずに通す。CI の lint.yml が必ず見る。
set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

files=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do
  case "$f" in
    .github/workflows/*.yml | .github/workflows/*.yaml) echo "$f" ;;
    .github/actions/*/action.yml | .github/actions/*/action.yaml) echo "$f" ;;
  esac
done)

[ -z "$files" ] && exit 0

if ! command -v jactionlint >/dev/null 2>&1 || ! jactionlint --version >/dev/null 2>&1; then
  echo "pre-commit: jactionlint が動かないので、workflow の検査を飛ばしました" >&2
  echo "pre-commit: 入れるなら  mise use -g github:jdx/jactionlint@2.3.0" >&2
  exit 0
fi

# shellcheck disable=SC2086
jactionlint $files
